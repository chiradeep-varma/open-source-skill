# Copy this file to .env and fill in real values before starting the app.
# The app refuses to start if SESSION_SECRET or ADMIN_PASSWORD is missing —
# there is no default password.

# Required. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Required. The single admin account used to sign in to the dashboard.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional. A bearer token for scripting the REST API without a browser session.
# curl -H "Authorization: Bearer $API_TOKEN" http://localhost:3000/api/links
API_TOKEN=

# The public URL this instance is reachable at. Used to build short links and
# QR codes. Set this to your real domain once you're behind a reverse proxy.
BASE_URL=http://localhost:3000

# Recommended. A fixed salt for hashing visitor IPs before storing them.
# Generate with: openssl rand -hex 16
# If left unset, a random salt is generated at startup and unique-visitor
# counts will reset whenever the process restarts.
IP_HASH_SALT=

PORT=3000

# Where the SQLite database file lives.
DB_PATH=./data/sunny-thicket.sqlite

# Set to "true" once the app is behind HTTPS (a reverse proxy) so session
# cookies are marked Secure.
COOKIE_SECURE=false

# Set to "true" if running behind a reverse proxy, so req.protocol and the
# client IP are read from X-Forwarded-* headers.
TRUST_PROXY=false
