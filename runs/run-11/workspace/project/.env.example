# Copy this file to .env and fill it in before running `docker compose up`.

# Postgres password for the db container. Any strong random string.
POSTGRES_PASSWORD=

# Session signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# The URL your team will actually use to reach this instance
# (e.g. https://boards.yourteam.com). Defaults to http://localhost:3000.
NEXTAUTH_URL=

# Optional: auto-create a first admin account on startup. Leave both blank
# to skip this and create your own initial state another way. Once you've
# signed in, use "Team" -> "Add teammate" in the app to add the rest of
# your 8-person team — you don't need to add them here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Port to expose the app on the host. Defaults to 3000.
PORT=3000
