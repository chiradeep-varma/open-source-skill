<%- include('../partials/header') %>

<h1>Admin</h1>

<section class="admin-section">
  <div class="admin-section-header">
    <h2>Components</h2>
    <a class="button" href="/admin/components/new">Add component</a>
  </div>
  <% if (components.length === 0) { %>
    <div class="empty-state">No components yet. Add the parts of your project people care about (API, website, database…).</div>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr><th>Name</th><th>Group</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% components.forEach(function (c) { %>
            <tr>
              <td><%= c.name %></td>
              <td><%= c.group_name || '—' %></td>
              <td><span class="badge"><span class="dot status-<%= c.status %>"></span><%= componentLabel(c.status) %></span></td>
              <td class="actions-cell">
                <a href="/admin/components/<%= c.id %>/edit">Edit</a>
                <form class="inline-form" method="post" action="/admin/components/<%= c.id %>/delete" onsubmit="return confirm('Delete this component?');">
                  <button type="submit" class="link-button">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="admin-section">
  <div class="admin-section-header">
    <h2>Incidents &amp; maintenance</h2>
    <div class="actions">
      <a class="button" href="/admin/incidents/new">New incident</a>
      <a class="button secondary" href="/admin/incidents/new?kind=maintenance">Schedule maintenance</a>
    </div>
  </div>
  <% if (incidents.length === 0) { %>
    <div class="empty-state">Nothing posted yet. Everything's quiet.</div>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr><th>Title</th><th>Impact</th><th>Status</th><th>Opened</th></tr>
        </thead>
        <tbody>
          <% incidents.forEach(function (i) { %>
            <tr>
              <td><a href="/admin/incidents/<%= i.id %>"><%= i.title %></a></td>
              <td><%= i.impact %></td>
              <td><span class="badge"><span class="dot status-<%= i.status %>"></span><%= i.status.replace('_', ' ') %></span></td>
              <td><%= new Date(i.created_at).toLocaleDateString('en-US', { dateStyle: 'medium' }) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
