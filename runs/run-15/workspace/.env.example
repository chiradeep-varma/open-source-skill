# Copy this file to .env and fill in real values before running in production.
# The launcher (osa.json) generates SESSION_SECRET and ADMIN_PASSWORD for you.

SITE_TITLE=Project Status
SITE_DESCRIPTION=Live status and incident history for my side projects.
PORT=3000
BASE_URL=http://localhost:3000

# A long random string used to sign session cookies.
SESSION_SECRET=change-me

# The password for the single built-in "admin" account.
ADMIN_PASSWORD=change-me

# Set to true once you're serving over HTTPS.
COOKIE_SECURE=false
