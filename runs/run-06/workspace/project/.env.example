# Copy to .env and fill in. Never commit .env.

# Public URL this instance is reachable at (used to build the OAuth redirect URI).
BASE_URL=https://scheduling.yourfirm.com

# SQLite file path (default is fine for a single VPS).
DATABASE_URL=sqlite:///./data/slotpilot.db

# Random long string — used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# From Google Cloud Console → APIs & Services → Credentials (OAuth client ID, type "Web
# application"). Redirect URI must be {BASE_URL}/admin/oauth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of the firm's Google account emails allowed to log in and manage
# their own availability/meeting types.
TEAM_EMAILS=alice@yourfirm.com,bob@yourfirm.com,carol@yourfirm.com,dave@yourfirm.com,erin@yourfirm.com,frank@yourfirm.com

DEFAULT_MIN_NOTICE_HOURS=4
DEFAULT_BOOKING_WINDOW_DAYS=21
