# Copy to .env and edit before running.

# Port the app listens on.
PORT=3000

# Base URL used to build short links shown in the dashboard/API (no trailing slash).
BASE_URL=http://localhost:3000

# Single admin password protecting the dashboard and API. Required.
ADMIN_PASSWORD=change-me

# Secret used to sign the session cookie AND to hash visitor IPs before storage.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too

# Where the SQLite database file lives.
DATABASE_PATH=./data/trimly.db
