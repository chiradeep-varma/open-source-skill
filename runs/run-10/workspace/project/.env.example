# Copy this file to .env and fill in real values before running Formstead.

# The first admin account is created automatically on first boot from these
# two variables. After that first boot, you can leave them as-is (they are
# ignored once an admin account already exists) or remove them.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-before-first-boot

# A long random string used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string

# Set to "true" once you're serving Formstead over HTTPS (e.g. behind a
# reverse proxy with a real certificate). Keep it "false" for local testing
# over plain HTTP.
COOKIE_SECURE=false

PORT=3000
