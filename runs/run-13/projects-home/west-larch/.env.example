# Copy this file to .env and fill it in. Every setting the app reads is listed here.

# Port the HTTP server listens on.
PORT=3000

# Public base URL, used to build shareable links and QR codes.
# Change this to your real domain when you deploy behind a reverse proxy.
BASE_URL=http://localhost:3000

# Required. A long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The app refuses to start without this set.
SESSION_SECRET=

# Optional. Where the SQLite database file lives.
DB_PATH=./data/west-larch.db
