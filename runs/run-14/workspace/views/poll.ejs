<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= poll.title %> — rustic-fjord</title>
  <link rel="stylesheet" href="/static/style.css" />
</head>
<body data-admin="<%= isAdmin %>">
  <div class="wrap">
    <header class="site">
      <a class="brand" href="/">rustic-fjord</a>
      <span class="tagline">a free, self-hosted scheduling poll</span>
    </header>

    <% if (isAdmin && created) { %>
      <div class="banner">
        Poll created. <strong>Keep this admin link</strong> — it's the only way to manage or finalize this poll.
      </div>
    <% } %>

    <% var finalizedOption = poll.status === 'finalized' ? options.find(function(o){ return o.id === poll.finalizedOptionId; }) : null; %>
    <% if (finalizedOption) { %>
      <div class="banner finalized">
        <strong>Scheduled:</strong> <span class="local-time" data-utc="<%= finalizedOption.startsAt %>"><%= finalizedOption.startsAt %></span>
      </div>
    <% } %>

    <h1><%= poll.title %></h1>
    <% if (poll.description) { %><p class="lede"><%= poll.description %></p><% } %>
    <% if (poll.location) { %><p class="lede">📍 <%= poll.location %></p><% } %>

    <% if (isAdmin) { %>
      <div class="card admin-panel">
        <h2>Admin</h2>
        <p class="hint">Share the link below with your group. Keep this page's URL to yourself — it's your admin link.</p>
        <label>Participant link</label>
        <div class="admin-link-box" id="participant-link"><%= '' %></div>

        <% if (poll.status === 'open') { %>
          <form method="post" action="/a/<%= poll.id %>/<%= adminToken %>/finalize" class="finalize-options" style="margin-top:16px;">
            <label>Finalize a time</label>
            <% options.forEach(function (o) { %>
              <label>
                <input type="radio" name="optionId" value="<%= o.id %>" <%= o.id === bestOptionId ? 'checked' : '' %> required />
                <span class="local-time" data-utc="<%= o.startsAt %>"><%= o.startsAt %></span>
                — <%= totals[o.id].yes %> yes, <%= totals[o.id].ifNeedBe %> if need be
              </label>
            <% }) %>
            <button type="submit">Finalize this time</button>
          </form>
        <% } else { %>
          <form method="post" action="/a/<%= poll.id %>/<%= adminToken %>/reopen">
            <button type="submit" class="secondary">Reopen voting</button>
          </form>
        <% } %>

        <p style="margin-top:16px;"><a href="/a/<%= poll.id %>/<%= adminToken %>/export.csv">Export results as CSV</a></p>
      </div>
    <% } %>

    <div class="card">
      <h2>Your availability</h2>
      <% if (poll.status === 'finalized') { %>
        <p class="hint">This poll has been finalized. Voting is closed.</p>
      <% } else { %>
        <div class="field">
          <label for="name">Your name</label>
          <input type="text" id="name" maxlength="80" value="<%= you ? you.name : '' %>" placeholder="So the organizer knows it's you" />
        </div>
        <div class="legend">
          <span><button type="button" class="small" disabled style="width:20px;height:20px;border-radius:50%;background:var(--yes-100);border-color:var(--yes-600);color:var(--yes-600);padding:0;">✓</button> Yes</span>
          <span><button type="button" class="small" disabled style="width:20px;height:20px;border-radius:50%;background:var(--need-100);border-color:var(--need-600);color:var(--need-600);padding:0;">~</button> If need be</span>
          <span><button type="button" class="small" disabled style="width:20px;height:20px;border-radius:50%;background:var(--no-100);border-color:var(--no-600);color:var(--no-600);padding:0;">✕</button> No</span>
        </div>
        <table class="grid" id="vote-grid">
          <thead>
            <tr>
              <th></th>
              <% options.forEach(function (o) { %>
                <th class="option-head <%= o.id === bestOptionId ? 'best' : '' %>">
                  <span class="option-time local-time" data-utc="<%= o.startsAt %>"><%= o.startsAt %></span>
                  <span class="option-duration"><%= o.durationMinutes %> min</span>
                </th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="name-cell">You</td>
              <% options.forEach(function (o) { %>
                <% var current = you && responsesByParticipant.get(you.id) ? responsesByParticipant.get(you.id).get(o.id) : null; %>
                <td class="vote-cell">
                  <button type="button" class="vote-btn <%= current ? 'active' : '' %>" data-option="<%= o.id %>" data-value="<%= current || '' %>">
                    <%= current === 'yes' ? '✓' : current === 'if_need_be' ? '~' : current === 'no' ? '✕' : '' %>
                  </button>
                </td>
              <% }) %>
            </tr>
          </tbody>
        </table>
        <div style="margin-top:16px;">
          <button type="button" id="save-vote">Save my availability</button>
          <span class="status-msg" id="vote-status"></span>
        </div>
      <% } %>
    </div>

    <div class="card">
      <h2>Results — <%= participants.length %> <%= participants.length === 1 ? 'person has' : 'people have' %> voted</h2>
      <% if (participants.length === 0) { %>
        <p class="hint">No one has voted yet. Be the first.</p>
      <% } else { %>
        <table class="grid">
          <thead>
            <tr>
              <th></th>
              <% options.forEach(function (o) { %>
                <th class="option-head <%= o.id === bestOptionId ? 'best' : '' %>">
                  <span class="option-time local-time" data-utc="<%= o.startsAt %>"><%= o.startsAt %></span>
                  <span class="option-duration"><%= o.durationMinutes %> min</span>
                </th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% participants.forEach(function (p) { %>
              <tr>
                <td class="name-cell"><%= p.name %></td>
                <% options.forEach(function (o) { %>
                  <% var v = responsesByParticipant.get(p.id) ? responsesByParticipant.get(p.id).get(o.id) : null; %>
                  <td><%= v === 'yes' ? '✓' : v === 'if_need_be' ? '~' : v === 'no' ? '✕' : '—' %></td>
                <% }) %>
              </tr>
            <% }) %>
            <tr class="totals-row">
              <td class="name-cell">Total</td>
              <% options.forEach(function (o) { %>
                <td>
                  <span class="score-yes"><%= totals[o.id].yes %> yes</span>,
                  <span class="score-need"><%= totals[o.id].ifNeedBe %> if need be</span>
                </td>
              <% }) %>
            </tr>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <script>
    window.__POLL__ = {
      id: <%- JSON.stringify(poll.id) %>,
      status: <%- JSON.stringify(poll.status) %>
    };
  </script>
  <script src="/static/app.js"></script>
</body>
</html>
